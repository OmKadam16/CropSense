        {
            "id": "image_vision_openai_6",
            "provider": "image_vision_openai",
            "name": "Pest Management",
            "config": {
                "profile": "openai-4o-mini",
                "openai-4-1": {},
                "parameters": {
                    "google": {}
                },
                "openai-4o-mini": {
                    "apikey": "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",
                    "systemPrompt": "Create a comprehensive pest and disease management plan with prevention, monitoring, and control strategies",
                    "prompt": "The farmer will be growing the top recommended crop in the following conditions:\n\nSoil Type: {texture_class}\nLocation: {location_country}\nClimate Zone: {climate_zone}\nCrop: top recommended crop\n\nCreate a comprehensive pest and disease management plan. Return ONLY valid JSON, no markdown, no code blocks, no explanations. Start with { and end with }\n\n{\n  \"pest_management\": {\n    \"crop\": \"crop name\",\n    \"high_risk_pests\": [\n      {\n        \"pest_name\": \"pest common name\",\n        \"scientific_name\": \"latin name if known\",\n        \"risk_level\": \"one of: very high, high, medium, low\",\n        \"season_active\": \"months when pest is most active\",\n        \"damage_description\": \"detailed description of what damage this pest causes\",\n        \"damage_threshold\": \"number of pests per plant that triggers control action\",\n        \"monitoring\": {\n          \"how_to_scout\": \"specific scouting method and what to look for\",\n          \"scouting_frequency\": \"how often to check (daily, weekly, bi-weekly, etc)\",\n          \"early_warning_signs\": [\"early warning sign 1\", \"early warning sign 2\", \"early warning sign 3\"]\n        },\n        \"prevention_strategies\": [\n          \"cultural practice 1 for prevention\",\n          \"cultural practice 2 for prevention\",\n          \"cultural practice 3 for prevention\"\n        ],\n        \"organic_control_methods\": [\n          \"organic method 1 with specific application details\",\n          \"organic method 2 with specific application details\",\n          \"organic method 3 with specific application details\"\n        ],\n        \"chemical_control_if_necessary\": {\n          \"pesticide_name\": \"name of pesticide\",\n          \"dosage\": \"amount per hectare\",\n          \"application_timing\": \"when to apply relative to crop growth stage\",\n          \"safety_precautions\": \"important safety precautions when applying\"\n      