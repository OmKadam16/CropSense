        {
            "id": "image_vision_openai_5",
            "provider": "image_vision_openai",
            "name": "Season planner",
            "config": {
                "profile": "openai-4o-mini",
                "openai-4-1": {},
                "parameters": {
                    "google": {}
                },
                "openai-4o-mini": {
                    "apikey": "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",
                    "systemPrompt": "Create a detailed 6-month planting calendar with specific tasks, water schedules, and fertilizer application timing",
                    "prompt": "The farmer will be growing the top recommended crop with the following profile:\n\nSoil Type: {texture_class}\npH: {pH_estimate}\nNitrogen Level: {nitrogen_status}\nPhosphorus Level: {phosphorus_status}\nLocation: {location_country}\nClimate Zone: {climate_zone}\n\nCreate a detailed 6-month operational calendar starting from next month. Include specific tasks, water scheduling, and fertilizer applications based on the soil profile. Return ONLY valid JSON, no markdown, no code blocks, no explanations. Start with { and end with }\n\n{\n  \"planting_calendar\": {\n    \"crop\": \"top recommended crop name\",\n    \"location\": \"{location_country}\",\n    \"planting_window_start_month\": number 1-12,\n    \"months\": [\n      {\n        \"month\": 1,\n        \"month_name\": \"January\",\n        \"phase\": \"one of: pre-planting, planting, growth, flowering, maturation, harvest\",\n        \"specific_tasks\": [\n          \"specific task 1 with exact details\",\n          \"specific task 2 with exact details\",\n          \"specific task 3 with exact details\"\n        ],\n        \"soil_preparation\": \"describe specific soil preparation needed for this month\",\n        \"water_schedule\": {\n          \"irrigation_frequency_per_week\": number,\n          \"irrigation_amount_liters_per_day\": number,\n          \"irrigation_method\": \"one of: drip, flood, sprinkler, rain-fed\",\n          \"rainfall_expectation\": \"describe expected rainfall pattern for this region in this month\"\n        },\n        \"fertilizer_applications\": [\n          {\n            \"timing\": \"number of weeks after planting or specific date\",\n            \"fertilizer_type\": \"N-P-K ratio like 10-20-10 or specific nutrient\",\n            \"amount_kg_per_hectare\": number,\n            \"application_method\": \"one of: broadcast, side-dress, foliar, fertigation\",\n            \"reason\": \"explain why this fertilizer at this specific time\"\n          }\n        ],\n        \"pest_monitoring\": [\"pest 1 to scout for\", \"pest 2 to scout for\"],\n        \"disease_monitoring\": [\"disease 1 to watch for\", \"disease 2 to watch for\"],\n        \"expected_plant_height_cm\": number,\n        \"critical_actions\": [\"action 1 that absolutely cannot be missed\", \"action 2 critical for success\"],\n        \"weather_alerts\": \"describe what weather conditions to watch out for this month\"\n      },\n      {\n        \"month\": 2,\n        \"month_name\": \"February\",\n        \"phase\": \"growth phase\",\n        \"specific_tasks\": [\"task 1\", \"task 2\", \"task 3\"],\n        \"soil_preparation\": \"description\",\n        \"water_schedule\": {\n          \"irrigation_frequency_per_week\": number,\n          \"irrigation_amount_liters_per_day\": number,\n          \"irrigation_method\": \"drip/flood/sprinkler/rain-fed\",\n          \"rainfall_expectation\": \"description\"\n        },\n        \"fertilizer_applications\": [{\n          \"timing\": \"timing\",\n          \"fertilizer_type\": \"type\",\n          \"amount_kg_per_hectare\": number,\n          \"application_method\": \"method\",\n          \"reason\": \"reason\"\n        }],\n        \"pest_monitoring\": [\"pest 1\", \"pest 2\"],\n        \"disease_monitoring\": [\"disease 1\"],\n        \"expected_plant_height_cm\": number,\n        \"critical_actions\": [\"action 1\"],\n        \"weather_alerts\": \"description\"\n      },\n      {\n        \"month\": 3,\n        \"month_name\": \"March\",\n        \"phase\": \"growth phase\",\n        \"specific_tasks\": [\"task 1\", \"task 2\"],\n        \"soil_preparation\": \"description\",\n        \"water_schedule\": {\n          \"irrigation_frequency_per_week\": number,\n          \"irrigation_amount_liters_per_day\": number,\n          \"irrigation_method\": \"method\",\n          \"rainfall_expectation\": \"description\"\n        },\n        \"fertilizer_applications\": [{\n          \"timing\": \"timing\",\n          \"fertilizer_type\": \"type\",\n          \"amount_kg_per_hectare\": number,\n          \"application_method\": \"method\",\n          \"reason\": \"reason\"\n        }],\n        \"pest_monitoring\": [\"pest 1\", \"pest 2\"],\n        \"disease_monitoring\": [\"disease 1\"],\n        \"expected_plant_height_cm\": number,\n        \"critical_actions\": [\"action 1\"],\n        \"weather_alerts\": \"description\"\n      },\n      {\n        \"month\": 4,\n        \"month_name\": \"April\",\n        \"phase\": \"flowering phase\",\n        \"specific_tasks\": [\"task 1\", \"task 2\"],\n        \"soil_preparation\": \"minimal\",\n        \"water_schedule\": {\n          \"irrigation_frequency_per_week\": number,\n          \"irrigation_amount_liters_per_day\": number,\n          \"irrigation_method\": \"method\",\n          \"rainfall_expectation\": \"description\"\n        },\n        \"fertilizer_applications\": [{\n          \"timing\": \"timing\",\n          \"fertilizer_type\": \"type\",\n          \"amount_kg_per_hectare\": number,\n          \"application_method\": \"method\",\n          \"reason\": \"reason\"\n        }],\n        \"pest_monitoring\": [\"pest 1\"],\n        \"disease_monitoring\": [\"disease 1\"],\n        \"expected_plant_height_cm\": number,\n        \"critical_actions\": [\"action 1\"],\n        \"weather_alerts\": \"description\"\n      },\n      {\n        \"month\": 5,\n        \"month_name\": \"May\",\n        \"phase\": \"maturation phase\",\n        \"specific_tasks\": [\"task 1\", \"task 2\"],\n        \"soil_preparation\": \"none\",\n        \"water_schedule\": {\n          \"irrigation_frequency_per_week\": number,\n          \"irrigation_amount_liters_per_day\": number,\n          \"irrigation_method\": \"method\",\n          \"rainfall_expectation\": \"description\"\n        },\n        \"fertilizer_applications\": [],\n        \"pest_monitoring\": [\"pest 1\"],\n        \"disease_monitoring\": [\"disease 1\"],\n        \"expected_plant_height_cm\": number,\n        \"critical_actions\": [\"monitor for readiness\"],\n        \"weather_alerts\": \"description\"\n      },\n      {\n        \"month\": 6,\n        \"month_name\": \"June\",\n        \"phase\": \"harvest phase\",\n        \"specific_tasks\": [\"harvest task 1\", \"post-harvest task 1\"],\n        \"soil_preparation\": \"post-harvest recovery\",\n        \"water_schedule\": {\n          \"irrigation_frequency_per_week\": 0,\n          \"irrigation_amount_liters_per_day\": 0,\n          \"irrigation_method\": \"none\",\n          \"rainfall_expectation\": \"description\"\n        },\n        \"fertilizer_applications\": [],\n        \"pest_monitoring\": [],\n        \"disease_monitoring\": [],\n        \"expected_plant_height_cm\": number,\n        \"critical_actions\": [\"harvest at optimal time\"],\n        \"weather_alerts\": \"description\"\n      }\n    ],\n    \"harvest_guidelines\": {\n      \"readiness_indicators\": [\"indicator 1 plant is ready to harvest\", \"indicator 2 plant is ready\"],\n      \"recommended_harvest_date\": \"specific month and date range\",\n      \"expected_yield_kg\": number,\n      \"harvesting_method\": \"description of how to harvest this crop\"\n    },\n    \"post_harvest\": {\n      \"storage_recommendations\": \"how to store and preserve the harvest\",\n      \"soil_recovery\": \"what to do after harvest to prepare soil for next crop\",\n      \"next_crop\": \"suggested next crop for rotation\"\n    }\n  }\n}"
                }
            },
