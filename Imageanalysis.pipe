        {
            "id": "image_vision_openai_4",
            "provider": "image_vision_openai",
            "name": "Crop Recommender",
            "config": {
                "profile": "openai-4o-mini",
                "openai-4-1": {},
                "parameters": {
                    "google": {}
                },
                "openai-4o-mini": {
                    "systemPrompt": "Recommend the top 5 most suitable crops based on soil conditions, climate, and farm characteristics",
                    "apikey": "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",
                    "prompt": "A farmer has the following soil profile and farm information:\n\nTexture: {texture_class}\nSand: {sand_percentage}% | Silt: {silt_percentage}% | Clay: {clay_percentage}%\nNitrogen: {nitrogen_status}\nPhosphorus: {phosphorus_status}\nPotassium: {potassium_status}\nOrganic Matter: {organic_matter_status}\npH: {pH_estimate}\nLocation: {location_country}\nFarm Size: {farm_size_hectares} hectares\nClimate Zone: {climate_zone}\n\nBased on this soil data and location, recommend the top 5 crops that would be most suitable. Return ONLY valid JSON, no markdown, no code blocks, no explanations. Start with { and end with }\n\n{\n  \"crop_recommendations\": [\n    {\n      \"rank\": 1,\n      \"crop_name\": \"specific crop name\",\n      \"suitability_score\": number 0-100,\n      \"soil_fit\": \"one of: excellent, good, fair, poor\",\n      \"climate_fit\": \"one of: excellent, good, fair, poor\",\n      \"market_demand\": \"one of: high, medium, low\",\n      \"water_requirements_liters_per_month\": number,\n      \"typical_yield_kg_per_hectare\": number,\n      \"pest_risks\": [\"list 2-3 most common pests for this crop\"],\n      \"soil_challenges\": [\"specific challenges this crop might face with this soil\"],\n      \"mitigation_strategies\": [\"how to overcome each challenge\"],\n      \"profitability_rating\": \"one of: high, medium, low\",\n      \"why_recommended\": \"brief explanation of why this crop suits the soil and location\"\n    },\n    {\n      \"rank\": 2,\n      \"crop_name\": \"crop name\",\n      \"suitability_score\": number 0-100,\n      \"soil_fit\": \"one of: excellent, good, fair, poor\",\n      \"climate_fit\": \"one of: excellent, good, fair, poor\",\n      \"market_demand\": \"one of: high, medium, low\",\n      \"water_requirements_liters_per_month\": number,\n      \"typical_yield_kg_per_hectare\": number,\n      \"pest_risks\": [\"pest 1\", \"pest 2\", \"pest 3\"],\n      \"soil_challenges\": [\"challenge 1\", \"challenge 2\"],\n      \"mitigation_strategies\": [\"strategy 1\", \"strategy 2\"],\n      \"profitability_rating\": \"one of: high, medium, low\",\n      \"why_recommended\": \"brief explanation\"\n    },\n    {\n      \"rank\": 3,\n      \"crop_name\": \"crop name\",\n      \"suitability_score\": number 0-100,\n      \"soil_fit\": \"one of: excellent, good, fair, poor\",\n      \"climate_fit\": \"one of: excellent, good, fair, poor\",\n      \"market_demand\": \"one of: high, medium, low\",\n      \"water_requirements_liters_per_month\": number,\n      \"typical_yield_kg_per_hectare\": number,\n      \"pest_risks\": [\"pest 1\", \"pest 2\"],\n      \"soil_challenges\": [\"challenge 1\"],\n      \"mitigation_strategies\": [\"strategy 1\"],\n      \"profitability_rating\": \"one of: high, medium, low\",\n      \"why_recommended\": \"brief explanation\"\n    },\n    {\n      \"rank\": 4,\n      \"crop_name\": \"crop name\",\n      \"suitability_score\": number 0-100,\n      \"soil_fit\": \"one of: excellent, good, fair, poor\",\n      \"climate_fit\": \"one of: excellent, good, fair, poor\",\n      \"market_demand\": \"one of: high, medium, low\",\n      \"water_requirements_liters_per_month\": number,\n      \"typical_yield_kg_per_hectare\": number,\n      \"pest_risks\": [\"pest 1\"],\n      \"soil_challenges\": [\"challenge 1\"],\n      \"mitigation_strategies\": [\"strategy 1\"],\n      \"profitability_rating\": \"one of: high, medium, low\",\n      \"why_recommended\": \"brief explanation\"\n    },\n    {\n      \"rank\": 5,\n      \"crop_name\": \"crop name\",\n      \"suitability_score\": number 0-100,\n      \"soil_fit\": \"one of: excellent, good, fair, poor\",\n      \"climate_fit\": \"one of: excellent, good, fair, poor\",\n      \"market_demand\": \"one of: high, medium, low\",\n      \"water_requirements_liters_per_month\": number,\n      \"typical_yield_kg_per_hectare\": number,\n      \"pest_risks\": [\"pest 1\"],\n      \"soil_challenges\": [\"challenge 1\"],\n      \"mitigation_strategies\": [\"strategy 1\"],\n      \"profitability_rating\": \"one of: high, medium, low\",\n      \"why_recommended\": \"brief explanation\"\n    }\n  ],\n  \"crop_rotation_advice\": \"recommendation for rotating crops in subsequent seasons\",\n  \"overall_note\": \"general assessment of farm agricultural potential and suitability\"\n}"
                }
            },
