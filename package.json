{
  "name": "cropsense-landing",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev:tailwind": "tailwindcss -i src/styles/tailwind.src.css -o src/styles/tailwind.css --watch",
